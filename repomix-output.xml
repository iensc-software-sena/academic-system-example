  border-radius: 1.2rem;
  box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.6);
  min-width: 30rem;
  min-height: 40rem;
  transition: transform 0.3s ease;
}

.card:hover {
  transform: scale(1.02);
}

.project-info {
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  align-items: center;
}

.project-name {
  color: black;
  font-size: 6rem;
}

.welcome-title {
  color: var(--purple);
  font-size: 2rem;
  margin-top: -5rem;
}

.logo-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 15rem;
  height: 15rem;
  border-radius: 1rem;
  box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.6);
}

.logo {
  width: 100px;
}

.login-form,
.form-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.5rem;
}

.login-title {
  font-size: 3rem;
  color: var(--purple);
}

.form-lb {
  font-weight: bold;
  font-size: 1.6rem;
  color: black;
}

.form-input {
  width: 15rem;
  height: 3rem;
  border: 0.1rem solid #cccccc;
  border-radius: 0.8rem;
  box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.6);
  text-align: center;
}

.wrong-input {
  display:none;
  text-align: center;
  width: 18rem;
  font-size: 1.2rem;
  color: red;
  margin-top: 1rem;
}

.form-button {
  background-color: var(--blue-light);
  color: white;
  margin-top: 1.5rem;
  border: none;
  border-radius: 0.8rem;
  font-weight: bold;
  cursor: pointer;
  transition: background-color 0.3s ease;
  width: 10rem;
  height: 3rem;
  box-shadow: 0px 5px 5px rgba(0, 0, 0, 0.6);
  font-size: 1.4rem;
  text-align: center;
}

.form-button:hover {
  background-color: var(--purple);
}

.linksBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 1.3rem;
}

.support, .forgot, .register {
  margin-top: 0.8rem;
  color: var(--blue-light);
  cursor: pointer;
  transition: color 0.3s ease, text-decoration 0.3s ease;
}

.support:hover,
.forgot:hover,
.register:hover {
  text-decoration: underline;
  color: var(--purple);
}

@media (min-width: 350px) {

  body {
    min-width: 35rem;
    min-height: 100rem;
  }

  .container {
    width: 90%;
    max-width: 36rem;
    height: 90rem;
  }

  .project-info {
    height: 30rem;
  }

  .project-name {
    font-size: 2rem;
  }

  .welcome-title {
    font-size: 1.6rem;
  }

  .login-form {
    height: 40rem;
  }
}

@media (min-width: 600px) {

  body {
    min-width: 60rem;
  }

  .container {
    max-width: 54rem;
  }

  .form-input {
    width: 20rem;
  }

}

@media (min-width: 900px) {

  body {
    min-width: 90rem;
    min-height: 70rem;
  }

  .container {
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    max-width: 80rem;
    height: 55rem;
  }

  .card {
    min-width: 35rem;
    height: 90%;
  }

  .form-input {
    width: 25rem;
  }

}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.container {
  animation: fadeIn 0.6s ease-in-out;
}
</file>

